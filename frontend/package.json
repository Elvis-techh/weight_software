{
    "name": "bascula-central",
    "version": "1.0.14",
    "description": "Weight tracking and administration system",
    "main": "main.js",
    "author": "Báscula Central Team",
    "scripts": {
        "postinstall": "electron-builder install-app-deps",
        "build:css": "tailwindcss -i ./css/tailwind-source.css -o ./css/tailwind.css --minify",
        "prestart": "npm run build:css",
        "predist": "npm run build:css",
        "predist:publish": "npm run build:css",
        "start": "electron .",
        "dist": "electron-builder --win nsis",
        "dist:publish": "electron-builder --win nsis --publish always"
    },
    "dependencies": {
        "electron-updater": "^6.1.7",
        "serialport": "^12.0.0",
        "@serialport/parser-readline": "^12.0.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "tailwindcss": "^3.4.0"
    },
    "build": {
        "publish": [
            {
                "provider": "github",
                "owner": "Elvis-techh",
                "repo": "weight_software",
                "releaseType": "release"
            }
        ],
        "appId": "com.basculacentral.desktop",
        "productName": "Báscula Central",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}
