[Unit]
Description=Run Bascula Central database backup hourly

[Timer]
# Hourly, not daily: a daily 04:00 backup means a disk failure at 15:00 loses a
# full working day of weighings, receipts and payroll. The snapshot is a few
# seconds of VACUUM INTO and runs safely alongside the live server, so the cost
# of the tighter cadence is negligible next to the loss window it closes.
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
