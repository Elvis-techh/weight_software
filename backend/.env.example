# Copy this file to .env (or export these as real environment variables on the
# droplet) and fill in real values. Never commit the filled-in file — .env is
# already in .gitignore.

# Server
PORT=3000
HOST=0.0.0.0
# Set to 1 when the API sits behind a reverse proxy (nginx terminating TLS for
# api.basculacentral.com). Without it every request looks like 127.0.0.1 and the
# rate limiter's IP fallback treats all callers as one client. Leave unset when
# Node is exposed directly — trusting X-Forwarded-For with no proxy in front
# would let a caller spoof its own address.
TRUST_PROXY=
# Requests allowed per client IP per 5-minute window. All the station's
# terminals share one public IP, so this is a per-station budget; an idle
# terminal spends ~40 just polling. Writes (anything but GET) also have their
# own per-minute budget.
RATE_LIMIT_PER_WINDOW=3000
WRITE_RATE_LIMIT_PER_MINUTE=120
# Error responses hide the raw message/details unless this is exactly "development".
# Leave unset in production. Set NODE_ENV=development locally to see full error bodies.
NODE_ENV=
# The OLD shared key, kept only while terminals switch to their own tokens
# (scripts/enroll-terminal.js; see "Tokens de terminal" in deploy/README.md).
# It is public — it shipped in frontend/js/globals.js and every installer — so
# remove it once every terminal is enrolled. With it unset and no terminal ever
# enrolled the server runs without auth (local only).
API_KEY=

# Set to 1 once every terminal runs app 1.0.22 or newer. Until then the
# changes older builds make without a reason (replacing Peso 2, payroll edits,
# the Corapsa paid/excluded switches) are accepted and logged in Historial de
# Cambios as unjustified; with 1 they are refused.
ENFORCE_JUSTIFICATIONS=

# DigitalOcean Spaces (S3-compatible object storage) for receipts/PDFs/images.
# Leave all SPACES_* unset to keep storing attachments as SQLite BLOBs (local/dev default).
# Generate keys at: DigitalOcean control panel -> API -> Spaces Keys (separate from droplet SSH keys).
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=weight-station-storage
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com

# Backups (scripts/backup-database.js, run hourly by deploy/bascula-backup.timer)
# Where local snapshots go, and how long they are kept on the droplet's own disk.
# The full history lives in Spaces under backups/ — local is only a same-disk
# stopgap, so a short retention here is deliberate.
BACKUP_DIR=
BACKUP_LOCAL_RETENTION_DAYS=2
